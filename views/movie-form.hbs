<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="movie-form-page">
    <h2>{{title}}</h2>

    <form action="{{formAction}}" method="POST" class="entity-form" enctype="multipart/form-data">
    <div class="form-field">
        <label>Название</label>
        <input type="text" name="title" value="{{movie.title}}" required>
      </div>

      <div class="form-field">
        <label>Описание</label>
        <textarea name="description" required>{{movie.description}}</textarea>
      </div>

      <div class="form-field">
        <label>Год</label>
        <input type="number" name="year" value="{{movie.year}}" required>
      </div>

      <div class="form-field">
        <label>Длительность</label>
        <input type="number" name="duration" value="{{movie.duration}}" required>
      </div>

      <div class="form-field">
        <label>Возрастной рейтинг</label>
        <input type="text" name="ageRating" value="{{movie.ageRating}}" required>
      </div>

      <div class="form-field">
        <label>Постер</label>
        {{#if movie.posterUrl}}
          <img
            src="{{movie.posterUrl}}"
            alt="{{movie.title}}"
            style="max-width: 180px; border-radius: 12px; margin-bottom: 10px;"
          >
        {{/if}}

        <input type="file" name="poster" accept="image/png,image/jpeg,image/webp,image/gif">
        <input type="text" name="posterUrl" value="{{movie.posterUrl}}" placeholder="Или вставьте ссылку на постер">
      </div>

      <div class="form-field">
        <label>Жанр</label>
        <select name="genreId" required>
          {{#each genres}}
            <option value="{{this.id}}"
              {{#if ../movie}}
                {{#ifEquals this.id ../movie.genreId}}selected{{/ifEquals}}
              {{/if}}>
              {{this.name}}
            </option>
          {{/each}}
        </select>
      </div>

      <fieldset class="movie-metadata">
        <legend>Для подбора и уведомлений</legend>
        <div class="form-field"><label for="actors">Актёры через запятую</label><input id="actors" name="actorNames" maxlength="800" value="{{movie.actorNames}}"></div>
        <div class="form-field"><label for="directors">Режиссёры через запятую</label><input id="directors" name="directorNames" maxlength="500" value="{{movie.directorNames}}"></div>
        <div class="form-field"><label for="franchise">Франшиза</label><input id="franchise" name="franchise" maxlength="120" value="{{movie.franchise}}"></div>
        <div class="form-field"><label for="release-date">Дата премьеры</label><input id="release-date" type="date" name="releaseDate" value="{{movie.releaseDate}}"></div>
        <div class="form-field"><label for="unusual">Необычное кино</label><select id="unusual" name="unusual"><option value="false">Нет</option><option value="true" {{#if movie.unusual}}selected{{/if}}>Да</option></select></div>
        <div class="form-field"><label for="providers">Где посмотреть · одна HTTPS-ссылка на строку</label><textarea id="providers" name="providerUrls" maxlength="2500">{{movie.providerUrls}}</textarea></div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="button">
          {{#if isEdit}}Сохранить{{else}}Добавить фильм{{/if}}
        </button>
        <a href="/movies" class="button button--secondary">Назад к каталогу</a>
      </div>
    </form>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>