<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="movie-page">
    <h2>{{movie.title}}</h2>

    <div class="movie-card-full">
      <div class="movie-poster-full">
        <img src="{{moviePoster movie.posterUrl movie.title movie.year}}" alt="{{movie.title}}">
      </div>

      <div class="movie-info movie-info-full">
        <p><strong>Описание:</strong> {{movie.description}}</p>
        <p><strong>Год:</strong> {{movie.year}}</p>
        <p><strong>Длительность:</strong> {{movie.duration}} мин</p>
        <p><strong>Возрастной рейтинг:</strong> {{movie.ageRating}}</p>
        <p><strong>Жанр:</strong> {{movie.genre.name}}</p>
      </div>
    </div>
    <div class="movie-actions">
      {{#if isAdmin}}
        <a href="/movies/{{movie.id}}/edit" class="button">Редактировать</a>

        <form action="/movies/{{movie.id}}/delete" method="POST" onsubmit="return confirm('Удалить фильм?')">
          <button type="submit" class="button button--danger">Удалить</button>
        </form>
      {{/if}}
      {{#if isAuth}}
        <form action="/favorites/movie/{{movie.id}}" method="POST"><button class="button" type="submit">{{#if favorite}}Убрать из избранного{{else}}В избранное{{/if}}</button></form>
      {{else}}<a class="button" href="/auth/login">Войдите, чтобы сохранить фильм</a>{{/if}}
      <a href="/movies" class="button button--danger">Назад к каталогу</a>
    </div>
  </section>
  <section class="profile-section"><h2>Отзывы зрителей</h2><p><a href="/reviews/movie/{{movie.id}}">Открыть обсуждение фильма</a></p>
    {{#each reviews}}<article class="profile-card"><h3>{{user.name}} · {{rating}}/10</h3><p>{{comment}}</p>{{#if canManage}}<a href="/reviews/{{id}}/edit">Изменить</a><form action="/reviews/{{id}}/delete" method="POST"><button class="button" type="submit">Удалить</button></form>{{/if}}</article>{{else}}<p>Отзывов пока нет. Будьте первым!</p>{{/each}}
    {{#if isAuth}}{{#unless ownReview}}<h3>Ваш отзыв</h3><form action="/reviews/add" method="POST" class="entity-form"><input type="hidden" name="movieId" value="{{movie.id}}"><div class="form-field"><label for="rating">Оценка от 1 до 10</label><input id="rating" name="rating" type="number" min="1" max="10" step="1" required></div><div class="form-field"><label for="comment">Отзыв</label><textarea id="comment" name="comment" required></textarea></div><button class="button" type="submit">Опубликовать</button></form>{{/unless}}{{else}}<p><a href="/auth/login">Войдите</a>, чтобы оставить отзыв.</p>{{/if}}
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>