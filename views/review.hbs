<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="movie-page">
    <h2>Отзыв на фильм {{review.movie.title}}</h2>

    <div class="profile-card">
      <p><strong>Автор:</strong> {{review.user.name}}</p>
      <p><strong>Оценка:</strong> {{review.rating}}/10</p>
      <p><strong>Текст отзыва:</strong> {{review.comment}}</p>
    </div>

    <div class="movie-actions">
      {{#if review.canManage}}
        <a href="/reviews/{{review.id}}/edit" class="button">Редактировать</a>

        <form action="/reviews/{{review.id}}/delete" method="POST">
          <button type="submit" class="button button--danger">Удалить</button>
        </form>

      {{/if}}
      <a href="/reviews/movie/{{review.movie.id}}" class="button button--secondary">К обсуждению фильма</a>
    </div>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>