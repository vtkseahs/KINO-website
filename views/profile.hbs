<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main>
  <section class="profile-section">
    <header class="profile-section-header">
      <h2>Мой профиль</h2>
    </header>

    <article class="profile-card">
      <div class="profile-header">
        <div class="profile-image">
          <img src="/img/avatar.png" alt="аватар">
        </div>

        <div class="profile-description">
          <h3>{{profile.name}}</h3>
          <p>{{profile.email}}</p>
          <p>Роль: {{profile.role}}</p>
          <p>Дата регистрации: {{profile.createdAt}}</p>
        </div>
      </div>

      <div class="movie-actions" style="margin-top: 20px;">
        <a href="/profile/edit?auth=1" class="button">Редактировать профиль</a>
      </div>
    </article>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>