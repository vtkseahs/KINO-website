<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="profile-section">
    <header class="profile-section-header">
      <h2>Мой профиль</h2>
      <p>Данные аккаунта, роль и доступ к КИНО Plus</p>
    </header>

    <article class="profile-card">
      <div class="profile-header">
        <div class="profile-image">
          <img src="/img/avatar.png" alt="аватар">
        </div>

        <div class="profile-description">
          <h3>{{profile.name}}</h3>
          <p><strong>Email:</strong> {{profile.email}}</p>
          <p><strong>Роль:</strong> {{profile.role}}</p>
          <p><strong>Дата регистрации:</strong> {{profile.createdAt}}</p>
        </div>
      </div>

      {{#if profile.plusActive}}
        <div class="profile-subscribe">
          <div class="profile-subscribe-header">
            <h4>КИНО Plus</h4>
            <span class="subscription-status">Доступ активен</span>
          </div>

          <p>Доступны персональные функции КИНО Plus.</p>
        </div>
      {{else}}
        <div class="profile-subscribe">
          <div class="profile-subscribe-header">
            <h4>КИНО Plus не активирован</h4>
          </div>
          <p>Активируйте доступ к персональным функциям</p>
        </div>
      {{/if}}

      <div class="section-actions">
        <form action="/profile/{{profile.id}}/delete" method="POST" onsubmit="return confirm('Удалить аккаунт и все связанные данные?')"><button class="button button--danger" type="submit">Удалить аккаунт</button></form>
        <a href="/profile/edit" class="button">Редактировать профиль</a>
        <a href="/subscribe" class="button button--secondary">КИНО Plus</a>
      </div>
    </article>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>
