<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="profile-section">
    <header class="profile-section-header">
      <h2>Мой профиль</h2>
      <p>Данные аккаунта, роль и текущая подписка</p>
    </header>

    <article class="profile-card">
      <div class="profile-header">
        <div class="profile-image">
          <img src="/img/avatar.png" alt="аватар">
        </div>

        <div class="profile-description">
          <h3>{{profile.name}}</h3>
          <p><strong>Email:</strong> {{profile.email}}</p>
          <p><strong>Роль:</strong> {{profile.role}}</p>
          <p><strong>Дата регистрации:</strong> {{profile.createdAt}}</p>
        </div>
      </div>

      {{#if profile.subscriptionPlan}}
        <div class="profile-subscribe">
          <div class="profile-subscribe-header">
            <h4>{{profile.subscriptionPlan.title}}</h4>
            <span class="subscription-status">Активна</span>
          </div>

          <p>{{profile.subscriptionPlan.description}}</p>
          <p><strong>Стоимость:</strong> {{profile.subscriptionPlan.price}} ₽ в месяц</p>
          <p><strong>Действует до:</strong> {{profile.subscriptionEndsAt}}</p>
        </div>
      {{else}}
        <div class="profile-subscribe">
          <div class="profile-subscribe-header">
            <h4>Подписка не оформлена</h4>
          </div>
          <p>Выберите подходящий тариф, чтобы получить доступ к подписке</p>
        </div>
      {{/if}}

      <div class="section-actions">
        <a href="/profile/edit" class="button">Редактировать профиль</a>
        <a href="/subscribe" class="button button--secondary">Перейти к подпискам</a>
      </div>
    </article>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>
