<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="recomended-movies" id="movies-list">
    <header class="recomended-movies-header">
      <h2>Каталог фильмов Kino</h2>
      <p>Выбирайте на свой вкус</p>

      <div class="movies-events">
        <h3>События каталога</h3>
        <ul id="movies-events-list">
          <li>Ожидание обновлений...</li>
        </ul>
      </div>

      <div class="movies-controls">
        <input class="search" type="text" placeholder="Поиск">
        <button class="button sort" data-sort="movie-title">
          Сортировать по названию
        </button>
      </div>
    </header>

    <div class="best-movies list">
      {{#each cards}}
        {{> card}}
      {{/each}}
    </div>
  </section>
</main>

{{> footer}}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const eventsList = document.getElementById('movies-events-list');
    if (!eventsList) return;

    const source = new EventSource('/movies/events');

    source.onmessage = (event) => {
      const data = JSON.parse(event.data);

      if (
        eventsList.children.length === 1 &&
        eventsList.children[0].textContent === 'Ожидание обновлений...'
      ) {
        eventsList.innerHTML = '';
      }

      const item = document.createElement('li');
      item.textContent = `[${data.time}] ${data.message}`;
      eventsList.prepend(item);

      while (eventsList.children.length > 5) {
        eventsList.removeChild(eventsList.lastChild);
      }
    };
  });
</script>
{{> scripts}}
</body>
</html>