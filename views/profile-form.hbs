<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="movie-form-page">
    <div class="page-header auth-card">
      <h2>{{title}}</h2>
      <p>Измените основные данные аккаунта</p>
    </div>

    <form action="{{formAction}}" method="POST" class="entity-form auth-card">
      <div class="form-field">
        <label for="name">Имя</label>
        <input
          id="name"
          type="text"
          name="name"
          value="{{profile.name}}"
          required
        >
      </div>

      <div class="form-field">
        <label for="email">Email</label>
        <input
          id="email"
          type="email"
          name="email"
          value="{{profile.email}}"
          required
        >
      </div>

      <div class="form-actions">
        <button type="submit" class="button">Сохранить</button>
        <a href="/profile" class="button button--secondary">Назад к профилю</a>
      </div>
    </form>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>
