<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="movie-form-page">
    <h2>{{title}}</h2>

    <form action="{{formAction}}" method="POST">
      <div>
        <label>Имя</label>
        <input type="text" name="name" value="{{profile.name}}" required>
      </div>

      <div>
        <label>Email</label>
        <input type="email" name="email" value="{{profile.email}}" required>
      </div>

      <button type="submit">Сохранить</button>
    </form>

    <a href="/profile?auth=1" class="button button--secondary">Назад к профилю</a>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>