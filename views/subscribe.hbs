<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main>
  <header class="page-header">
    <h2>Выбери свою подписку</h2>
    <p>Доступ к миллионам фильмов и сериалов за один клик</p>
  </header>

  {{#if currentSubscription}}
    {{#if currentSubscription.plan}}
      <section class="profile-section" style="margin-bottom: 32px;">
        <article class="profile-card">
          <h3>Моя текущая подписка</h3>
          <p><strong>Тариф:</strong> {{currentSubscription.plan.title}}</p>
          <p><strong>Цена:</strong> {{currentSubscription.plan.price}} ₽ в месяц</p>
          <p><strong>Действует до:</strong> {{currentSubscription.endsAt}}</p>
          <form action="/subscribe/cancel" method="POST">
            <button type="submit" class="button button--outline">Отменить подписку</button>
          </form>
        </article>
      </section>
    {{/if}}
  {{/if}}

  <section class="price-info">
    <div class="tarif-plan">
      {{#each plans}}
        <article class="plan-card">
          <header class="plan-header">
            <h3>{{this.title}}</h3>
            <div class="price">
              <p>{{this.price}} ₽ в месяц</p>
            </div>
          </header>

          <p>{{this.description}}</p>

          <div class="plan-actions">
            <a href="/subscribe/{{this.id}}" class="button button--secondary">Подробнее</a>

            {{#if ../isAuth}}
              <form action="/subscribe/{{this.id}}/buy" method="POST">
                <button type="submit" class="button button--secondary">Выбрать</button>
              </form>
            {{else}}
              <a href="/auth/login" class="button button--secondary">Войти</a>
            {{/if}}

            {{#if ../isAdmin}}
              <a href="/subscribe/{{this.id}}/edit" class="button button--secondary">Редактировать</a>
              <form action="/subscribe/{{this.id}}/delete" method="POST">
                <button type="submit" class="button button--danger">Удалить</button>
              </form>
            {{/if}}
          </div>
        </article>
      {{else}}
        <p>Тарифы пока не добавлены</p>
      {{/each}}
    </div>
  </section>

  <section class="faq-section">
    <h2>Частые вопросы</h2>

    <div class="faq-list">
      <article class="faq-item">
        <h3>Как оплатить подписку?</h3>
        <p>Мы принимаем банковские карты и электронные кошельки.</p>
      </article>

      <article class="faq-item">
        <h3>Можно ли отменить подписку?</h3>
        <p>Да, вы можете отменить подписку в любой момент</a>.</p>
      </article>

      <article class="faq-item">
        <h3>Есть ли пробный период?</h3>
        <p>Новые пользователи получают <strong>7 дней бесплатного доступа!</strong></p>
      </article>
    </div>
  </section>

  <section class="plans-table">
    <h2>Сравнение тарифов</h2>
    <table class="table-tarif">
      <thead>
      <tr>
        <th>Тариф</th>
        <th>Описание</th>
        <th>Срок</th>
        <th>Цена в мес</th>
      </tr>
      </thead>
      <tbody>
      {{#each plans}}
        <tr>
          <td>{{this.title}}</td>
          <td>{{this.description}}</td>
          <td>{{this.durationDays}} дней</td>
          <td>{{this.price}} ₽</td>
        </tr>
      {{else}}
        <tr>
          <td colspan="4">Тарифы пока отсутствуют</td>
        </tr>
      {{/each}}
      </tbody>
    </table>
  </section>

  {{#if isAdmin}}
    <div class="admin-add-row">
      <a href="/subscribe/add" class="button">Добавить тариф</a>
    </div>
  {{/if}}
</main>

{{> footer}}
{{> scripts}}
</body>
</html>
