<!DOCTYPE html>
<html lang="ru">
<head>
  {{> head}}
</head>
<body>
{{> header}}

<main class="content">
  <section class="movie-form-page">
    <h2>{{title}}</h2>

    <form action="{{formAction}}" method="POST" class="entity-form">
      <div class="form-field">
        <label>Фильм</label>
        <select name="movieId" required>
          {{#each movies}}
            <option value="{{this.id}}"
              {{#if ../review}}
                {{#ifEquals this.id ../review.movieId}}selected{{/ifEquals}}
              {{/if}}>
              {{this.title}} ({{this.year}})
            </option>
          {{/each}}
        </select>
      </div>

      <div class="form-field">
        <label>Оценка</label>
        <input
          type="number"
          name="rating"
          min="1"
          max="10"
          value="{{review.rating}}"
          required
        >
      </div>

      <div class="form-field">
        <label>Текст отзыва</label>
        <textarea name="comment" required>{{review.comment}}</textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="button">
          {{#if isEdit}}Сохранить{{else}}Добавить отзыв{{/if}}
        </button>
        <a href="/reviews" class="button button--secondary">Назад к списку</a>
      </div>
    </form>
  </section>
</main>

{{> footer}}
{{> scripts}}
</body>
</html>