generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)

  superTokensUserId String? @unique

  // История тарифов до перехода на демодоступ Plus.
  subscriptionPlanId Int?
  subscriptionEndsAt DateTime?
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  reviews   Review[]
  favorites Favorite[]
  views MovieView[]
  discussionPosts DiscussionPost[]
  discussionLikes DiscussionLike[]
  plusAccess PlusAccess?
  journal JournalEntry[]
  interests MovieInterest[]
  groupPicks GroupPick[]
  groupVotes GroupVote[]
}

model Genre {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  movies Movie[]
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  year        Int
  duration    Int
  ageRating   String
  posterUrl   String?
  actors      String[] @default([])
  directors   String[] @default([])
  franchise   String?
  premiereOn  DateTime? @db.Date
  unusual     Boolean @default(false)
  watchLinks  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id])

  reviews   Review[]
  favorites Favorite[]
  views MovieView[]
  discussionPosts DiscussionPost[]
  journal JournalEntry[]
  groupVotes GroupVote[]
}

model DiscussionPost {
  id Int @id @default(autoincrement())
  content String
  createdAt DateTime @default(now())
  userId Int
  movieId Int
  parentId Int?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  parent DiscussionPost? @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies DiscussionPost[] @relation("DiscussionReplies")
  likes DiscussionLike[]
  @@index([movieId, createdAt])
  @@index([parentId])
}

model DiscussionLike {
  userId Int
  postId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
}

model MovieView {
  id Int @id @default(autoincrement())
  userId Int
  movieId Int
  viewedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  @@index([userId, viewedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  Int
  movieId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId  Int
  movieId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

enum Role {
  USER
  ADMIN
}

model SubscriptionPlan {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  price        Int
  durationDays Int
  createdAt    DateTime @default(now())

  users User[]
}

enum ActivationResult {
  SUCCESS
  FAILED
}

model PlusAccess {
  userId Int @id
  activatedAt DateTime?
  endsAt DateTime?
  lastResult ActivationResult
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum JournalStatus {
  WANT
  WATCHING
  WATCHED
  DROPPED
  REWATCH
  DISMISSED
}

model JournalEntry {
  userId Int
  movieId Int
  status JournalStatus
  watchedOn DateTime? @db.Date
  notes String @default("")
  impression String @default("")
  company String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([movieId])
}

enum InterestKind {
  ACTOR
  DIRECTOR
  FRANCHISE
  GENRE
  PREMIERE
}

model MovieInterest {
  id Int @id @default(autoincrement())
  userId Int
  kind InterestKind
  label String
  value String
  createdAt DateTime @default(now())
  seenAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, value])
}


model GroupPick {
  id String @id @default(uuid())
  ownerId Int
  movieIds Int[]
  expiresAt DateTime
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  votes GroupVote[]

  @@index([ownerId, expiresAt])
}

model GroupVote {
  groupId String
  userId Int
  movieId Int
  group GroupPick @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([movieId])
  @@index([userId])
}
