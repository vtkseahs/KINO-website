generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)

  superTokensUserId String? @unique

  subscriptionPlanId Int?
  subscriptionEndsAt DateTime?
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  reviews   Review[]
  favorites Favorite[]
  views MovieView[]
  discussionPosts DiscussionPost[]
  discussionLikes DiscussionLike[]
}

model Genre {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  movies Movie[]
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  year        Int
  duration    Int
  ageRating   String
  posterUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id])

  reviews   Review[]
  favorites Favorite[]
  views MovieView[]
  discussionPosts DiscussionPost[]
}

model DiscussionPost {
  id Int @id @default(autoincrement())
  content String
  createdAt DateTime @default(now())
  userId Int
  movieId Int
  parentId Int?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  parent DiscussionPost? @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies DiscussionPost[] @relation("DiscussionReplies")
  likes DiscussionLike[]
  @@index([movieId, createdAt])
  @@index([parentId])
}

model DiscussionLike {
  userId Int
  postId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
}

model MovieView {
  id Int @id @default(autoincrement())
  userId Int
  movieId Int
  viewedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  @@index([userId, viewedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  Int
  movieId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  userId  Int
  movieId Int

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

enum Role {
  USER
  ADMIN
}

model SubscriptionPlan {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  price        Int
  durationDays Int
  createdAt    DateTime @default(now())

  users User[]
}